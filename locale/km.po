msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_10000"
msgid "TOTAL ACTIVO (A + B)"
msgstr "ទ្រព្យសកម្មសរុប (A + B)"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11000"
msgid "A) ACTIVO NO CORRIENTE"
msgstr "A) ទ្រព្យសកម្មមិនមែនចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11100"
msgid "I. Inmovilizado intangible"
msgstr "I. ទ្រព្យសកម្មអរូបី"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11200"
msgid "II. Inmovilizado material"
msgstr "II. អចលនទ្រព្យ រោងចក្រ និងបរិក្ខារ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11300"
msgid "III. Inversiones inmobiliarias"
msgstr "III. អចលនទ្រព្យវិនិយោគ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11400"
msgid "IV. Inversiones en empresas del grupo y asociadas a largo plazo"
msgstr "IV. ការវិនិយោគរយៈពេលវែងក្នុងក្រុមហ៊ុនក្នុងក្រុម និងក្រុមហ៊ុនសម្ព័ន្ធ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11500"
msgid "V. Inversiones financieras a largo plazo"
msgstr "V. ការវិនិយោគហិរញ្ញវត្ថុរយៈពេលវែង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11600"
msgid "VI. Activos por impuesto diferido"
msgstr "VI. ទ្រព្យសកម្មពន្ធពន្យារ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_11700"
msgid "VII. Deudores comerciales no corrientes"
msgstr "VII. គណនីអតិថិជនត្រូវទទួលមិនមែនចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12000"
msgid "B) ACTIVO CORRIENTE"
msgstr "B) ទ្រព្យសកម្មចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12100"
msgid "I. Activos no corrientes mantenidos para la venta"
msgstr "I. ទ្រព្យសកម្មមិនមែនចរន្តដែលកាន់កាប់សម្រាប់លក់"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12200"
msgid "II. Existencias"
msgstr "II. សន្និធិ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12300"
msgid "III. Deudores comerciales y otras cuentas a cobrar"
msgstr "III. គណនីអតិថិជន និងគណនីត្រូវទទួលផ្សេងទៀត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12370"
msgid "2. Accionistas (socios) por desembolsos exigidos"
msgstr "2. ចំនួនដែលត្រូវទទួលពីភាគហ៊ុនិក (ដៃគូ) ដែលត្រូវបានទាមទារឱ្យបង់"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12380"
msgid "1. Clientes por ventas y prestaciones de servicios"
msgstr "1. គណនីអតិថិជនត្រូវទទួលពីការលក់ និងការផ្តល់សេវា"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12381"
msgid "a) Clientes por ventas y prestaciones de servicios a largo plazo"
msgstr "a) គណនីអតិថិជនត្រូវទទួលពីការលក់ និងការផ្តល់សេវារយៈពេលវែង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12382"
msgid "b) Clientes por ventas y prestaciones de servicios a corto plazo"
msgstr "b) គណនីអតិថិជនត្រូវទទួលពីការលក់ និងការផ្តល់សេវារយៈពេលខ្លី"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12390"
msgid "3. Otros deudores"
msgstr "3. គណនីត្រូវទទួលផ្សេងទៀត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12400"
msgid "IV. Inversiones en empresas del grupo y asociadas a corto plazo"
msgstr "IV. ការវិនិយោគរយៈពេលខ្លីក្នុងក្រុមហ៊ុនក្នុងក្រុម និងក្រុមហ៊ុនសម្ព័ន្ធ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12500"
msgid "V. Inversiones financieras a corto plazo"
msgstr "V. ការវិនិយោគហិរញ្ញវត្ថុរយៈពេលខ្លី"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12600"
msgid "VI. Periodificaciones a corto plazo"
msgstr "VI. ធាតុបង្គរ និងធាតុបង់មុនរយៈពេលខ្លី"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_12700"
msgid "VII. Efectivo y otros activos líquidos equivalentes"
msgstr "VII. សាច់ប្រាក់ និងសមមូលសាច់ប្រាក់ផ្សេងទៀត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_20000"
msgid "A) PATRIMONIO NETO"
msgstr "A) មូលធន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21000"
msgid "A-1) Fondos propios"
msgstr "A-1) មូលធនផ្ទាល់ខ្លួន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21100"
msgid "I. Capital"
msgstr "I. ដើមទុន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21110"
msgid "1. Capital escriturado"
msgstr "1. ដើមទុនដែលបានចុះបញ្ជី"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21120"
msgid "2. (Capital no exigido)"
msgstr "2. (ដើមទុនដែលមិនទាន់បានទាមទារឱ្យបង់)"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21200"
msgid "II. Prima de emisión"
msgstr "II. បុព្វលាភលើការចេញភាគហ៊ុន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21300"
msgid "III. Reservas"
msgstr "III. ទុនបម្រុង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21400"
msgid "IV. (Acciones y participaciones en patrimonio propias)"
msgstr "IV. (ភាគហ៊ុន និងចំណែកមូលធនរបស់ខ្លួនដែលកាន់កាប់ដោយក្រុមហ៊ុន)"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21500"
msgid "V. Resultados de ejercicios anteriores"
msgstr "V. លទ្ធផលនៃគ្រាមុន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21600"
msgid "VI. Otras aportaciones de socios"
msgstr "VI. ការរួមចំណែកផ្សេងទៀតរបស់ភាគហ៊ុនិក"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21700"
msgid "VII. Resultado del ejercicio"
msgstr "VII. លទ្ធផលនៃគ្រាគណនេយ្យ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21800"
msgid "VIII. (Dividendo a cuenta)"
msgstr "VIII. (ភាគលាភបណ្តោះអាសន្ន)"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_21900"
msgid "IX. Otros instrumentos de patrimonio neto"
msgstr "IX. ឧបករណ៍មូលធនផ្សេងទៀត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_22000"
msgid "A-2) Ajustes por cambios de valor"
msgstr "A-2) និយ័តកម្មពីការប្រែប្រួលតម្លៃ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_23000"
msgid "A-3) Subvenciones, donaciones y legados recibidos"
msgstr "A-3) ជំនួយឧបត្ថម្ភ អំណោយ និងបណ្ដាំមរតកដែលបានទទួល"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_30000"
msgid "TOTAL PATRIMONIO NETO Y PASIVO (A + B + C)"
msgstr "មូលធន និងបំណុលសរុប (A + B + C)"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31000"
msgid "B) PASIVO NO CORRIENTE"
msgstr "B) បំណុលមិនមែនចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31100"
msgid "I. Provisiones a largo plazo"
msgstr "I. សំវិធានធនរយៈពេលវែង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31200"
msgid "II. Deudas a largo plazo"
msgstr "II. បំណុលរយៈពេលវែង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31220"
msgid "1. Deudas con entidades de crédito"
msgstr "1. បំណុលចំពោះស្ថាប័នឥណទាន"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31230"
msgid "2. Acreedores por arrendamiento financiero"
msgstr "2. បំណុលភតិសន្យាហិរញ្ញវត្ថុ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31290"
msgid "3. Otras deudas a largo plazo"
msgstr "3. បំណុលរយៈពេលវែងផ្សេងទៀត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31300"
msgid "III. Deudas con empresas del grupo y asociadas a largo plazo"
msgstr "III. បំណុលរយៈពេលវែងចំពោះក្រុមហ៊ុនក្នុងក្រុម និងក្រុមហ៊ុនសម្ព័ន្ធ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31400"
msgid "IV. Pasivos por impuesto diferido"
msgstr "IV. បំណុលពន្ធពន្យារ"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31500"
msgid "V. Periodificaciones a largo plazo"
msgstr "V. ធាតុបង្គរ និងធាតុបង់មុនរយៈពេលវែង"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31600"
msgid "VI. Acreedores comerciales no corrientes"
msgstr "VI. គណនីពាណិជ្ជកម្មត្រូវទូទាត់មិនមែនចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_31700"
msgid "VII. Deuda con características especiales a largo plazo"
msgstr "VII. បំណុលរយៈពេលវែងដែលមានលក្ខណៈពិសេស"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_32000"
msgid "C) PASIVO CORRIENTE"
msgstr "C) បំណុលចរន្ត"

msgctxt ""
"model:account.financial.statement.template.line,name:es_2021_balance_abreviado_32100"
msgid ""
"I. Pasivos vinculados con activos no corrientes mantenidos para la venta"
